    "version": "0.2.0",
    "configurations": [
    {
      "name": "Run Kleine",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run Kleine (web)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/start-server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      // "internalConsoleOptions": "neverOpen",
      "env": {
        "PORT": "8000"
      }
    }
    ]
}