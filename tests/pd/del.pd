#N canvas 0 0 500 400 10;
#X obj 20 20 inlet;
#X obj 160 20 inlet;
#X obj 20 80 del \$1 \$2 \$3;
#X obj 20 120 timer;
#X obj 160 80 loadbang;
#X obj 20 160 expr ceil($f1 * \$4 / 1000 - 0.001);
#X obj 20 200 print DEL;
#X connect 0 0 2 0;
#X connect 1 0 2 1;
#X connect 2 0 3 1;
#X connect 4 0 3 0;
#X connect 3 0 5 0;
#X connect 5 0 6 0;
